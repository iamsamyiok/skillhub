{
  "asset_id": "bench_v1",
  "name": "Garden Bench",
  "category": "furniture",
  "version": 1,
  "origin": "base_center",
  "orientation": "random",
  "asset_module": "asset.js",
  "max_triangles": 200,
  "footprint": {
    "type": "box",
    "hw_param": "half_len",
    "hd_param": "half_wid"
  },
  "height": {
    "param": "length",
    "factor": 0,
    "offset": 0.85
  },
  "params_schema": {
    "type": "object",
    "required": [
      "length"
    ],
    "properties": {
      "length": {
        "type": "number",
        "min": 1.3,
        "max": 2.1,
        "default": 1.7,
        "description": "seat length"
      },
      "wood_tint": {
        "type": "number",
        "min": -0.05,
        "max": 0.05,
        "default": 0,
        "description": "wood tone shift"
      },
      "half_len": {
        "type": "number",
        "min": 0.65,
        "max": 1.05,
        "default": 0.85,
        "description": "footprint half length"
      },
      "half_wid": {
        "type": "number",
        "min": 0.3,
        "max": 0.35,
        "default": 0.33,
        "description": "footprint half width"
      }
    }
  }
}
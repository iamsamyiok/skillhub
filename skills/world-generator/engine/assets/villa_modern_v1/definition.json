{
  "asset_id": "villa_modern_v1",
  "name": "Modern Two-Storey Villa",
  "category": "building",
  "version": 1,
  "origin": "base_center",
  "orientation": "fixed",
  "asset_module": "asset.js",
  "max_triangles": 600,
  "footprint": {
    "type": "box",
    "hw_param": "width",
    "hw_factor": 0.5,
    "hw_offset": 1.9,
    "hd_param": "depth",
    "hd_factor": 0.5,
    "hd_offset": 0.25
  },
  "height": {
    "param": "width",
    "factor": 0.75
  },
  "params_schema": {
    "type": "object",
    "required": [
      "width"
    ],
    "properties": {
      "width": {
        "type": "number",
        "min": 8,
        "max": 13,
        "default": 10,
        "description": "main body width (x)"
      },
      "depth": {
        "type": "number",
        "min": 6,
        "max": 11,
        "default": 8,
        "description": "main body depth (z)"
      },
      "upper_scale": {
        "type": "number",
        "min": 0.55,
        "max": 0.85,
        "default": 0.7,
        "description": "upper floor footprint ratio"
      },
      "wall_tint": {
        "type": "number",
        "min": -0.05,
        "max": 0.05,
        "default": 0,
        "description": "wall tone shift"
      },
      "glass_glow": {
        "type": "number",
        "min": 0.1,
        "max": 1.0,
        "default": 0.5,
        "description": "window emissive"
      }
    }
  }
}
{
  "asset_id": "hedge_bush_v1",
  "name": "Hedge Bush",
  "category": "vegetation",
  "version": 1,
  "origin": "base_center",
  "orientation": "random",
  "asset_module": "asset.js",
  "max_triangles": 600,
  "footprint": {
    "type": "circle",
    "radius_param": "radius"
  },
  "height": {
    "param": "radius",
    "factor": 1.3
  },
  "params_schema": {
    "type": "object",
    "required": [
      "radius"
    ],
    "properties": {
      "radius": {
        "type": "number",
        "min": 0.35,
        "max": 0.9,
        "default": 0.55,
        "description": "bush radius"
      },
      "flower": {
        "type": "number",
        "min": 0,
        "max": 1,
        "default": 0,
        "description": "bloom amount"
      },
      "hue_shift": {
        "type": "number",
        "min": -0.05,
        "max": 0.05,
        "default": 0,
        "description": "leaf hue variation"
      }
    }
  }
}
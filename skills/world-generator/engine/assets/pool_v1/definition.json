{
  "asset_id": "pool_v1",
  "name": "Swimming Pool",
  "category": "structure",
  "version": 1,
  "origin": "base_center",
  "orientation": "fixed",
  "asset_module": "asset.js",
  "max_triangles": 200,
  "footprint": {
    "type": "box",
    "hw_param": "width",
    "hw_factor": 0.5,
    "hw_offset": 0.8,
    "hd_param": "depth",
    "hd_factor": 0.5,
    "hd_offset": 0.8
  },
  "height": {
    "param": "width",
    "factor": 0,
    "offset": 0.45
  },
  "params_schema": {
    "type": "object",
    "required": [
      "width"
    ],
    "properties": {
      "width": {
        "type": "number",
        "min": 5,
        "max": 9,
        "default": 7.5,
        "description": "water span (x)"
      },
      "depth": {
        "type": "number",
        "min": 3,
        "max": 5.5,
        "default": 4,
        "description": "water span (z)"
      },
      "water_hue": {
        "type": "number",
        "min": 0.5,
        "max": 0.62,
        "default": 0.55,
        "description": "water hue"
      }
    }
  }
}
{
  "name": "world-generator",
  "version": "1.0.0",
  "description": "Universal parameterized 3D world generator: AI plans semantics, engine solves geometry, single-file world.html output with interactive edit loop",
  "type": "module",
  "scripts": {
    "build:villa": "node engine/index.mjs --scene scenes/villa",
    "edit-server": "node engine/edit-server.mjs --port 8770 --root .",
    "test:visual": "node engine/visual-check.mjs scenes/villa/world.html",
    "test:edit": "node engine/test-edit-flow.mjs"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
